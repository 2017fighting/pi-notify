{
  "name": "@raincore/pi-notify",
  "version": "0.1.1",
  "description": "Cross-platform notification extension for Pi — native OS, Gotify, Telegram, ntfy, and Bark notifications for agent lifecycle events",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "raincore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2017fighting/pi-notify.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "notify",
    "notifications",
    "bark",
    "gotify",
    "ntfy",
    "telegram"
  ],
  "scripts": {
    "test": "tsc --noEmit && npx tsx --test src/__tests__/*.test.ts __tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "*.ts",
    "assets/*",
    "platforms/*",
    "tui/*",
    "vendored/*",
    "skills/**/*",
    "README.md"
  ],
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^24",
    "tsx": "^4",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0 || ^0.85.0 || ^0.86.0",
    "@earendil-works/pi-tui": "^0.84.0 || ^0.85.0 || ^0.86.0",
    "typebox": "^1.1.38"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [],
    "themes": []
  }
}
